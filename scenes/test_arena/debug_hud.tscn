[node name="ControlsLabel" type="RichTextLabel" parent="MarginRoot/ControlsPanel"]
layout_mode = 2
mouse_filter = 2
bbcode_enabled = true
text = "[b][color=#eef6ff]CONTROLS (F2: Hide)[/color][/b]
[b]WASD[/b]: Move  |  [b]Space[/b]: Jump
[b]Shift / K[/b]: Dodge (i-frames & Cancel)
[b]LMB / J[/b]: Ground & Air Combo
[b]RMB / F[/b]: Launcher -> Chain LMB in Air!
[b]Q / E[/b]: Class Skill (Parry / Shadow Dash)
[b]Tab / MMB[/b]: Lock-On  |  [b]Esc[/b]: Free Cursor
[b]C[/b]: Switch Class  |  [b]F1[/b]: CRT  |  [b]R[/b]: Reset"
fit_content = true
scroll_active = false

