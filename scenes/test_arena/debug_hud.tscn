[node name="ControlsLabel" type="RichTextLabel" parent="MarginRoot/ControlsPanel"]
layout_mode = 2
mouse_filter = 2
bbcode_enabled = true
text = "[b][color=#eef6ff]CONTROLS (F2: Toggle Debug)[/color][/b]
[b]WASD[/b]: Move  |  [b]Space (2x)[/b]: Jump / Double Jump / Slide-Hop
[b]Shift / K[/b]: Dodge (Backflip p/ Trás, 5x = Stumble)
[b]Ctrl[/b]: Slide (Momentum >= 8.4m/s)
[b]LMB / J[/b]: Combo (Frente=Stinger, Trás=Launcher, Ar+S=Slam)
[b]F[/b]: Parry / Class Skill (3.0s Cooldown)
[b]1-9 / Scroll[/b]: Hotbar (Espada no Slot 1)
[b]Tab / MMB[/b]: Lock-On  |  [b]Esc[/b]: Free Cursor
[b]C[/b]: Switch Class  |  [b]F1[/b]: CRT  |  [b]R[/b]: Reset"
fit_content = true
scroll_active = false

